VITE_API_BASE_URL=/api

# If your backend runs elsewhere, set a full URL.
# Example:
# VITE_API_BASE_URL=https://api.e-sides.co.mz/api

# If your images live on a specific domain/origin, set it here.
# Example for e-sides (forces images from apex even if app is on www):
# VITE_ASSETS_BASE_URL=https://e-sides.co.mz
